# Additive constraints for the new local DDR mailbox only.
# The source keeps the payload until response/ack. Two destination sync stages
# plus request exposure/arbitration precede consumption. An 8 ns bundle budget
# is shorter than one 96 MHz destination period; no payload path is made false.
# Legacy capture_private.sdc stays byte-identical.
set local_request_registers [get_cells {analysis_req_addr[10]~FF analysis_req_addr[11]~FF analysis_req_addr[12]~FF analysis_req_addr[13]~FF analysis_req_addr[14]~FF analysis_req_addr[15]~FF analysis_req_addr[16]~FF analysis_req_addr[17]~FF analysis_req_addr[18]~FF analysis_req_addr[19]~FF analysis_req_addr[20]~FF analysis_req_addr[21]~FF analysis_req_addr[22]~FF analysis_req_addr[23]~FF analysis_req_addr[4]~FF analysis_req_addr[5]~FF analysis_req_addr[6]~FF analysis_req_addr[7]~FF analysis_req_addr[8]~FF analysis_req_addr[9]~FF analysis_req_data[0]~FF analysis_req_data[100]~FF analysis_req_data[101]~FF analysis_req_data[102]~FF analysis_req_data[103]~FF analysis_req_data[104]~FF analysis_req_data[105]~FF analysis_req_data[106]~FF analysis_req_data[107]~FF analysis_req_data[108]~FF analysis_req_data[109]~FF analysis_req_data[10]~FF analysis_req_data[110]~FF analysis_req_data[111]~FF analysis_req_data[112]~FF analysis_req_data[113]~FF analysis_req_data[114]~FF analysis_req_data[115]~FF analysis_req_data[116]~FF analysis_req_data[117]~FF analysis_req_data[118]~FF analysis_req_data[119]~FF analysis_req_data[11]~FF analysis_req_data[120]~FF analysis_req_data[121]~FF analysis_req_data[122]~FF analysis_req_data[123]~FF analysis_req_data[124]~FF analysis_req_data[125]~FF analysis_req_data[126]~FF analysis_req_data[127]~FF analysis_req_data[12]~FF analysis_req_data[13]~FF analysis_req_data[14]~FF analysis_req_data[15]~FF analysis_req_data[16]~FF analysis_req_data[17]~FF analysis_req_data[18]~FF analysis_req_data[19]~FF analysis_req_data[1]~FF analysis_req_data[20]~FF analysis_req_data[21]~FF analysis_req_data[22]~FF analysis_req_data[23]~FF analysis_req_data[24]~FF analysis_req_data[25]~FF analysis_req_data[26]~FF analysis_req_data[27]~FF analysis_req_data[28]~FF analysis_req_data[29]~FF analysis_req_data[2]~FF analysis_req_data[30]~FF analysis_req_data[31]~FF analysis_req_data[32]~FF analysis_req_data[33]~FF analysis_req_data[34]~FF analysis_req_data[35]~FF analysis_req_data[36]~FF analysis_req_data[37]~FF analysis_req_data[38]~FF analysis_req_data[39]~FF analysis_req_data[3]~FF analysis_req_data[40]~FF analysis_req_data[41]~FF analysis_req_data[42]~FF analysis_req_data[43]~FF analysis_req_data[44]~FF analysis_req_data[45]~FF analysis_req_data[46]~FF analysis_req_data[47]~FF analysis_req_data[48]~FF analysis_req_data[49]~FF analysis_req_data[4]~FF analysis_req_data[50]~FF analysis_req_data[51]~FF analysis_req_data[52]~FF analysis_req_data[53]~FF analysis_req_data[54]~FF analysis_req_data[55]~FF analysis_req_data[56]~FF analysis_req_data[57]~FF analysis_req_data[58]~FF analysis_req_data[59]~FF analysis_req_data[5]~FF analysis_req_data[60]~FF analysis_req_data[61]~FF analysis_req_data[62]~FF analysis_req_data[63]~FF analysis_req_data[64]~FF analysis_req_data[65]~FF analysis_req_data[66]~FF analysis_req_data[67]~FF analysis_req_data[68]~FF analysis_req_data[69]~FF analysis_req_data[6]~FF analysis_req_data[70]~FF analysis_req_data[71]~FF analysis_req_data[72]~FF analysis_req_data[73]~FF analysis_req_data[74]~FF analysis_req_data[75]~FF analysis_req_data[76]~FF analysis_req_data[77]~FF analysis_req_data[78]~FF analysis_req_data[79]~FF analysis_req_data[7]~FF analysis_req_data[80]~FF analysis_req_data[81]~FF analysis_req_data[82]~FF analysis_req_data[83]~FF analysis_req_data[84]~FF analysis_req_data[85]~FF analysis_req_data[86]~FF analysis_req_data[87]~FF analysis_req_data[88]~FF analysis_req_data[89]~FF analysis_req_data[8]~FF analysis_req_data[90]~FF analysis_req_data[91]~FF analysis_req_data[92]~FF analysis_req_data[93]~FF analysis_req_data[94]~FF analysis_req_data[95]~FF analysis_req_data[96]~FF analysis_req_data[97]~FF analysis_req_data[98]~FF analysis_req_data[99]~FF analysis_req_data[9]~FF analysis_req_write~FF u_ar0135_capture_link/Gen_Local.mailbox/req_toggle~FF}]
if {[llength $local_request_registers] != 150} {error "Local mailbox register set changed"}
set_max_delay -from $local_request_registers -to [get_clocks clk_sys] 8
set_min_delay -from $local_request_registers -to [get_clocks clk_sys] 0
# Asynchronous assertion inputs of the two new reset synchronizers only.
set local_reset_sr [get_pins {local_arb_reset/release_pipe[0]~FF|SR arb_rst_n~FF|SR u_ar0135_capture_link/Gen_Local.local_axi_reset/release_pipe[0]~FF|SR u_ar0135_capture_link/Gen_Local.ar~FF|SR}]
if {[llength $local_reset_sr] != 4} {error "Local reset SR pin set changed"}
set_false_path -to $local_reset_sr

# New bank metadata is captured only after the existing two-stage check ack.
set local_bank_ce [get_pins {u_ar0135_capture_link/freezer/event_bank[0]~FF|CE u_ar0135_capture_link/freezer/event_bank[1]~FF|CE}]
if {[llength $local_bank_ce] != 2} {error "New frozen-bank CE endpoint set changed"}
set_max_delay -from [get_clocks clk_lvds_1x] -to $local_bank_ce 8
set_min_delay -from [get_clocks clk_lvds_1x] -to $local_bank_ce 0
