# END CAPTURE PRIVATE BASELINE
if {[llength [get_cells {u_ar0135_capture_link/*}]] == 0 || [llength [get_cells -regexp {^(?!u_ar0135_capture_link/).*}]] == 0} {
 error "Capture/legacy cell selection empty; refusing unbounded CDC"
}
set capture_budget_cells [get_cells -regexp {^u_ar0135_capture_link/(?!(u_key_(app|auto|view|plus|minus)/.*|key_press\[[0-4]\])~FF$).*}]
if {[llength $capture_budget_cells] == 0} {error "Capture budget selection empty"}
set_max_delay -from [get_clocks clk_sys] -to [get_clocks cmos_pclk] -through $capture_budget_cells 8
set_min_delay -from [get_clocks clk_sys] -to [get_clocks cmos_pclk] -through $capture_budget_cells 0
set_max_delay -from [get_clocks cmos_pclk] -to [get_clocks clk_sys] -through $capture_budget_cells 8
set_min_delay -from [get_clocks cmos_pclk] -to [get_clocks clk_sys] -through $capture_budget_cells 0
if {[llength [get_pins -regexp {^u_ar0135_capture_link/link_reset/release_pipe\[0\]\~FF\|SR$}]] != 1} { error "Missing/ambiguous capture reset SR pin" }
